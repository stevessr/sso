# Strong independent secrets (openssl rand -base64 48)
SSO_ADMIN_TOKEN=replace-with-a-strong-admin-secret-at-least-32-characters
SSO_REGISTRATION_TOKEN=replace-with-a-different-registration-token-at-least-32-chars
SSO_PUBLIC_URL=http://localhost:3000
SSO_BIND=127.0.0.1:3000
SSO_AUTO_PORT=false
DATABASE_URL=sqlite://sso.db
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SSO_PROVIDERS_JSON=[]

# Independent 32-byte encryption master key for TOTP (openssl rand -hex 32)
SSO_MFA_ENCRYPTION_KEY=

# Optional: delete administrative audit records older than N days (7..3650).
# Unset/0 means retain indefinitely. Back up audit data before enabling.
# SSO_AUDIT_RETENTION_DAYS=90

# Optional Cloudflare Zero Trust integration (account-scoped API token, never a Global API key).
# Requires Access Apps and Policies Read, and Groups/Organizations Read for group inventory.
# Grant Access Apps and Policies Revoke only if global application revocation is needed.
SSO_CLOUDFLARE_ACCOUNT_ID=
SSO_CLOUDFLARE_API_TOKEN=
# DANGEROUS: revokes all users' sessions for a linked Access application; default false.
SSO_CLOUDFLARE_ENABLE_REVOKE=false

# DANGEROUS: manually revoke ONE user's sessions across ALL Access apps, not just
# one app. Does not affect WARP devices by default. Requires Organizations/Groups Write.
# Must be explicitly enabled independently of application-wide revocation.
SSO_CLOUDFLARE_ENABLE_USER_REVOKE=false
