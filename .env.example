# Production requires a stable HTTPS issuer matching your reverse proxy.
SSO_PUBLIC_URL=http://127.0.0.1:8080
SSO_BIND=127.0.0.1:8080
SSO_DATABASE_URL=sqlite://sso.db?mode=rwc
SSO_DATA_DIR=./data
# Generate independently: openssl rand -hex 32
SSO_SIGNING_KEY_HEX=REPLACE_WITH_64_HEX_CHARACTERS
SSO_ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
SSO_REGISTRATION_TOKEN=REPLACE_WITH_A_SEPARATE_LONG_RANDOM_SECRET
# Upstream provider credentials: only configured providers are enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
# Additional provider definitions, JSON array of Provider config objects.
SSO_PROVIDERS_JSON=[]
